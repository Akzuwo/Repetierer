{
  "name": "repetierer",
  "version": "7.0.0",
  "description": "(:",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Akzuwo/Repetierer.git"
  },
  "main": "app.js",
  "scripts": {
    "cloudflare:check": "node scripts/cloudflare-ci-check.js",
    "test:cloudflare": "node --test test/cloudflareE2E.test.js",
    "cloudflare:deploy": "wrangler deploy --config cloudflare/wrangler.jsonc --env=",
    "cloudflare:types": "wrangler types --config cloudflare/wrangler.jsonc cloudflare/worker-configuration.d.ts",
    "build:css": "tailwindcss -c tailwind.config.js -i ./public/tailwind.input.css -o ./public/tailwind.css --minify",
    "build:ui-vendor": "node scripts/build-ui-vendor.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:ui": "node scripts/ui-polish-smoke.js",
    "test:debug": "node scripts/debug-ui-check.cjs",
    "test:stats": "node --test test/repetitionDuration.test.js && node scripts/liquid-refinement-focused.cjs --stats-drawer",
    "test:kristall": "node scripts/kristall-reference-check.cjs && node scripts/kristall-ui-check.cjs",
    "start": "npm run build:css && electron . ",
    "start:debug": "electron . --debug",
    "build": "electron-builder",
    "build:local": "powershell -ExecutionPolicy Bypass -File ./build-local.ps1",
    "release": "electron-builder -p=always",
    "release:ci": "node scripts/release-with-icon.js"
  },
  "build": {
    "appId": "net.srpnt3.repetierer",
    "productName": "Repetierer",
    "directories": {
      "output": "./builds"
    },
    "files": [
      "app.js",
      "src/**/*",
      "public/index.html",
      "public/splash.html",
      "public/splash.js",
      "public/renderProcess.js",
      "public/jokerDateMigration.js",
      "public/assessmentRenderer.js",
      "public/aiRenderer.js",
      "public/visualFeedback.js",
      "public/uiMotion.js",
      "public/debugMode.js",
      "public/scrollEffects.js",
      "public/vendor/**/*",
      "public/style.css",
      "public/kristall/**/*",
      "public/tailwind.css",
      "public/icons/icon.ico",
      "public/icons/icon.png",
      "public/icons/*.svg",
      "public/fonts/**/*",
      "release-notes.txt",
      "installer-license.txt",
      "LICENSE",
      "package.json",
      "!public/tailwind.input.css",
      "!public/icons/icon.ai",
      "!public/images/**",
      "!importer-samples/**",
      "!builds/**",
      "!scripts/**",
      "!*.xlsx"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Akzuwo",
        "repo": "Repetierer",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "./public/icons/icon.ico",
      "signExts": [
        "!.exe"
      ]
    },
    "nsis": {
      "installerIcon": "./public/icons/icon.ico",
      "uninstallerIcon": "./public/icons/icon.ico",
      "installerSidebar": "./public/images/sidebar.bmp",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Repetierer",
      "runAfterFinish": true,
      "license": "installer-license.txt",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Repetierer-${version}.${ext}"
    }
  },
  "author": "srpnt3, Jonas-Luetolf, Akzuwo",
  "dependencies": {
    "electron-updater": "^6.8.3",
    "exceljs": "^4.2.1",
    "nodemailer": "^9.1.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261013.1",
    "autoprefixer": "^10.4.20",
    "electron": "^41.3.0",
    "electron-builder": "^26.5.0",
    "electron-packager": "^15.2.0",
    "esbuild": "0.28.2",
    "gsap": "3.15.0",
    "postcss": "^8.4.49",
    "rcedit": "^2.3.0",
    "tailwindcss": "^3.4.17",
    "thinking-orbs": "0.3.2",
    "wrangler": "^4.150.0"
  }
}
