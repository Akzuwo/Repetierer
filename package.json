{
  "name": "repetierer",
  "version": "7.0.0",
  "buildNumber": 28,
  "buildDate": "09112026",
  "description": "(:",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Akzuwo/Repetierer.git"
  },
  "main": "app.js",
  "scripts": {
    "build:css": "tailwindcss -i ./public/tailwind.input.css -o ./public/tailwind.css --minify",
    "build:ui-vendor": "node scripts/build-ui-vendor.js",
    "test": "node scripts/run-tests.cjs",
    "test:ui": "node scripts/ui-polish-smoke.js",
    "test:notifications": "node --test test/notifications.test.js && node scripts/liquid-refinement-focused.cjs --notifications",
    "test:homework": "node --test test/homework.test.js && node scripts/homework-ui-check.cjs",
    "test:debug": "node scripts/debug-ui-check.cjs",
    "test:debug:exe": "node scripts/debug-exe-check.cjs",
    "test:integrations": "node --test test/assessmentLifecycle.test.js test/aiIntegration.test.js && node scripts/integration-lifecycle-ui-check.cjs",
    "test:stats": "node --test test/repetitionDuration.test.js && node scripts/liquid-refinement-focused.cjs --stats-drawer",
    "test:kristall": "node scripts/kristall-reference-check.cjs && node scripts/kristall-ui-check.cjs",
    "start": "npm run build:css && electron . ",
    "start:debug": "electron . --debug-mode",
    "build": "electron-builder",
    "build:local": "powershell -ExecutionPolicy Bypass -File ./build-local.ps1",
    "release": "electron-builder -p=always",
    "release:ci": "node scripts/release-with-icon.js",
    "test:repository": "node scripts/check-repository.cjs"
  },
  "build": {
    "appId": "net.srpnt3.repetierer",
    "productName": "Repetierer",
    "directories": {
      "output": "./builds"
    },
    "files": [
      "app.js",
      "src/**/*",
      "public/index.html",
      "public/splash.html",
      "public/splash.js",
      "public/renderProcess.js",
      "public/settingsScope.js",
      "public/homeworkPage.js",
      "public/notifications.js",
      "public/jokerDateMigration.js",
      "public/assessmentRenderer.js",
      "public/aiRenderer.js",
      "public/visualFeedback.js",
      "public/uiMotion.js",
      "public/debugMode.js",
      "public/scrollEffects.js",
      "public/customSelect.js",
      "public/excelEditorPage.js",
      "public/vendor/**/*",
      "public/style.css",
      "public/kristall/**/*",
      "public/tailwind.css",
      "public/icons/icon.ico",
      "public/icons/icon.png",
      "public/icons/*.svg",
      "public/fonts/**/*",
      "release-notes.txt",
      "installer-license.txt",
      "LICENSE",
      "package.json",
      "!public/tailwind.input.css",
      "!public/icons/icon.ai",
      "!public/images/**",
      "!importer-samples/**",
      "!builds/**",
      "!scripts/**",
      "!*.xlsx"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Akzuwo",
        "repo": "Repetierer",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "./public/icons/icon.ico",
      "signExts": [
        "!.exe"
      ]
    },
    "nsis": {
      "installerIcon": "./public/icons/icon.ico",
      "uninstallerIcon": "./public/icons/icon.ico",
      "installerSidebar": "./public/images/sidebar.bmp",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Repetierer",
      "runAfterFinish": true,
      "license": "installer-license.txt",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Repetierer-${version}.${ext}"
    }
  },
  "author": "srpnt3, Jonas-Luetolf, Akzuwo",
  "dependencies": {
    "electron-updater": "^6.8.11",
    "exceljs": "^4.4.0",
    "nodemailer": "^10.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261113.1",
    "@tailwindcss/cli": "^4.3.5",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.1",
    "esbuild": "^0.28.2",
    "gsap": "^3.15.1",
    "rcedit": "^5.0.2",
    "tailwindcss": "^4.3.5",
    "thinking-orbs": "^0.3.2",
    "wrangler": "^4.161.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "brace-expansion@^1.1.7": "^1.1.22",
    "app-builder-lib": {
      "minimatch": "^11.0.8"
    },
    "@electron/universal": {
      "minimatch": "^11.0.8"
    },
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
